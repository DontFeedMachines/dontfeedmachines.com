---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <h1>Don't Feed<br>Machines</h1>
    <div style="height: 3px; background: black; width: 100%; margin: 2rem 0;"></div>
    <p>a clean, sharp rejection of algorithmic synthesis. we demand transparency, attribution, and a web built for human minds, not machine training sets.</p>
    
    <div style="margin-top: 3rem; border: 2px dashed black; padding: 3rem; text-align: center; cursor: crosshair; transition: background 0.2s, color 0.2s;" onmouseover="this.style.background='black'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='black'">
      <h2 style="margin: 0; font-size: 2rem;">[ Disconnect Protocol ]</h2>
      <p style="margin: 1rem auto 0 auto; font-size: 1.2rem;">-</p>
    </div>
</BaseLayout>
