---
// src/layouts/BaseLayout.astro
const { frontmatter } = Astro.props;
const title = frontmatter?.title || "Don't Feed Machines";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
        <div class="grid-bg"></div>
        <nav class="nav">
            <a href="/">Home</a>
            <a href="/manifesto">Manifesto</a>
            <a href="/tactics">Tactics</a>
        </nav>
        <div class="container">
            <div class="badge">100%<br>HUMAN</div>
            <slot />
        </div>
	</body>
</html>

<style>
  :root {
    --c-white: #ffffff;
    --c-black: #000000;
    --c-gray: #d4d4d4;
  }
  
  body {
    background: var(--c-white);
    color: var(--c-black);
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 2rem;
  }

  .grid-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: 
      linear-gradient(to right, var(--c-gray) 1px, transparent 1px),
      linear-gradient(to bottom, var(--c-gray) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: -1;
  }

  .nav {
    max-width: 1200px;
    margin: 0 auto 2rem auto;
    display: flex;
    gap: 2rem;
  }
  .nav a {
    color: var(--c-black);
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    border: 2px solid var(--c-black);
    padding: 0.5rem 1rem;
    background: var(--c-white);
    transition: all 0.2s;
  }
  .nav a:hover {
    background: var(--c-black);
    color: var(--c-white);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    background: var(--c-white);
    border: 3px solid var(--c-black);
    box-shadow: 15px 15px 0 var(--c-black);
    padding: 4rem;
    position: relative;
  }

  .badge {
    position: absolute;
    top: -20px;
    right: -20px;
    background: var(--c-black);
    color: var(--c-white);
    padding: 1rem;
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: bold;
    transform: rotate(15deg);
    font-size: 0.8rem;
  }

</style>
<style is:global>
  /* Global markdown styles */
  .container h1 {
    font-size: 4rem;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    letter-spacing: -2px;
  }
  .container h2, .container h3 {
    text-transform: uppercase;
    letter-spacing: -1px;
    margin-top: 3rem;
  }
  
  .container p {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 800px;
  }
</style>
